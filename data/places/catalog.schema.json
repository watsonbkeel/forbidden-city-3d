{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palace place explanation catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "language": {
      "const": "zh-CN"
    },
    "status": {
      "enum": [
        "design-sample-not-shipped",
        "reviewed-for-release",
        "reviewed-local-candidate"
      ]
    },
    "baseCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourcePolicy": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/place"
      }
    }
  },
  "required": [
    "schemaVersion",
    "language",
    "status",
    "baseCommit",
    "reviewedAt",
    "sourcePolicy",
    "sources",
    "places"
  ],
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "period": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "sourceIds"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "period": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "text",
        "sourceIds",
        "period"
      ]
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "person",
            "person-group",
            "role-group"
          ]
        },
        "relation": {
          "enum": [
            "resident",
            "temporary-resident",
            "ceremonial-access",
            "ceremony-participant",
            "government-participant",
            "wedding-participant",
            "changed-use",
            "inscription-author",
            "administrator"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "period": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "kind",
        "relation",
        "text",
        "sourceIds",
        "period"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "const": "故宫博物院"
        },
        "url": {
          "type": "string",
          "pattern": "^https://([a-z0-9-]+\\.)?dpm\\.org\\.cn/"
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "retrievalMethod": {
          "enum": [
            "official-indexed-page",
            "official-live-page",
            "official-cached-source"
          ]
        },
        "publishedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "publisher",
        "url",
        "reviewedAt",
        "retrievalMethod",
        "publishedAt"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "layout",
            "zone"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "zoneId": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "layout"
            }
          },
          "not": {
            "required": [
              "zoneId"
            ]
          }
        },
        {
          "properties": {
            "kind": {
              "const": "zone"
            }
          },
          "required": [
            "zoneId"
          ]
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teleportTargetName": {
          "type": "string",
          "minLength": 1
        },
        "navigationMode": {
          "enum": [
            "existing-teleport",
            "exterior-view"
          ]
        },
        "actionLabel": {
          "type": "string",
          "minLength": 1
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "teleportTargetName",
        "navigationMode",
        "actionLabel",
        "disclaimer"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not-verified",
            "dated-notice-requires-recheck"
          ]
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "notice": {
          "$ref": "#/$defs/fact"
        },
        "noticePublishedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "effectiveFrom": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reopensAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "disclaimer",
        "sourceIds",
        "checkedAt"
      ]
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "functionTag": {
          "type": "string",
          "minLength": 1
        },
        "sceneBinding": {
          "$ref": "#/$defs/binding"
        },
        "summary": {
          "$ref": "#/$defs/fact"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "people": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/person"
          }
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "residenceNote": {
          "$ref": "#/$defs/fact"
        },
        "modelExperience": {
          "$ref": "#/$defs/model"
        },
        "siteAccess": {
          "$ref": "#/$defs/access"
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "interiorGuide": {
          "$ref": "#/$defs/interiorGuide"
        }
      },
      "required": [
        "id",
        "name",
        "functionTag",
        "sceneBinding",
        "summary",
        "functions",
        "people",
        "timeline",
        "modelExperience",
        "siteAccess",
        "reviewedAt"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "people": {
                "contains": {
                  "properties": {
                    "relation": {
                      "enum": [
                        "resident",
                        "temporary-resident"
                      ]
                    }
                  },
                  "required": [
                    "relation"
                  ]
                }
              }
            }
          },
          "then": {
            "required": [
              "residenceNote"
            ]
          }
        }
      ]
    },
    "guideItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?![\\s\\S]*[<>])[\\s\\S]*\\S[\\s\\S]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^(?![\\s\\S]*[<>])[\\s\\S]*\\S[\\s\\S]*$"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "sourceIds"
      ]
    },
    "interiorGuide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^(?![\\s\\S]*[<>])[\\s\\S]*\\S[\\s\\S]*$"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/guideItem"
          }
        }
      },
      "required": [
        "notice",
        "items"
      ]
    }
  }
}
