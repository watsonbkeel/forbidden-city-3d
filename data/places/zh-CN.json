  "places": [
    {
      "id": "wumen",
      "name": "午门",
      "functionTag": "宫城正门与仪典",
      "sceneBinding": {
        "kind": "layout",
        "name": "午门"
      },
      "summary": {
        "text": "紫禁城南面的正门，也是举行重要仪典的场所。",
        "sourceIds": [
          "wumen"
        ]
      },
      "functions": [
        {
          "text": "承担宫城出入与仪典功能；朝廷曾在这里颁布历书、举行献俘礼。",
          "sourceIds": [
            "wumen"
          ],
          "period": "明清"
        }
      ],
      "people": [
        {
          "name": "皇帝、皇后与殿试前三名",
          "kind": "role-group",
          "relation": "ceremonial-access",
          "text": "中门通常供皇帝通行；皇后大婚入宫与殿试前三名出宫有特定礼制安排。",
          "sourceIds": [
            "wumen"
          ],
          "period": "明清"
        }
      ],
      "timeline": [
        {
          "text": "午门建成。",
          "sourceIds": [
            "wumen"
          ],
          "period": "1420"
        },
        {
          "text": "清代曾两度重修。",
          "sourceIds": [
            "wumen"
          ],
          "period": "1647、1801"
        }
      ],
