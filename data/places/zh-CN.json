    {
      "id": "taihe",
      "name": "太和殿",
      "functionTag": "国家典礼",
      "sceneBinding": {
        "kind": "layout",
        "name": "太和殿"
      },
      "summary": {
        "text": "登极、册后以及重要节庆的朝贺，都曾在这里举行。",
        "sourceIds": [
          "taihe"
        ]
      },
      "functions": [
        {
          "text": "用于重大典礼，包括节庆朝贺；清初也曾举行殿试，后来殿试改在保和殿。",
          "sourceIds": [
            "taihe"
          ],
          "period": "明清"
        }
      ],
      "people": [
        {
          "name": "明清皇帝",
          "kind": "role-group",
          "relation": "ceremony-participant",
          "text": "在此主持登极、册后等盛典并接受朝贺。",
          "sourceIds": [
            "taihe"
          ],
          "period": "明清"
        }
      ],
      "timeline": [
        {
          "text": "建成时称奉天殿，后称皇极殿，清初改为太和殿。",
          "sourceIds": [
            "taihe"
          ],
          "period": "1420—1645"
        },
        {
          "text": "康熙年间重建工程奠定了今天所见的形制。",
          "sourceIds": [
            "taihe-rebuild"
          ],
          "period": "1695—1697"
        }
      ],
