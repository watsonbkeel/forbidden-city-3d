    {
      "id": "taihe-gate",
      "name": "太和门",
      "functionTag": "外朝门户与听政",
      "sceneBinding": {
        "kind": "layout",
        "name": "太和门"
      },
      "summary": {
        "text": "外朝的主要宫门；明代皇帝曾在这里接受奏事、处理政务。",
        "sourceIds": [
          "taihe-gate"
        ]
      },
      "functions": [
        {
          "text": "明代用于御门听政，清初也曾继续使用；清代后来把御门听政移到乾清门。",
          "sourceIds": [
            "taihe-gate"
          ],
          "period": "明至清"
        }
      ],
      "people": [
        {
          "name": "福临（顺治帝）",
          "kind": "person",
          "relation": "ceremony-participant",
          "text": "1644 年在太和门颁布大赦令。",
          "sourceIds": [
            "taihe-gate"
          ],
          "period": "1644"
        }
      ],
      "timeline": [
        {
          "text": "始称奉天门，后改皇极门，清初定名太和门。",
          "sourceIds": [
            "taihe-gate"
          ],
          "period": "1420—1645"
        },
        {
          "text": "在前一年火灾后重建。",
          "sourceIds": [
            "taihe-gate"
          ],
          "period": "1889"
        }
      ],
