  "guide": {
    "notice": "本节依据已保存的故宫官方资料整理，未核验当前陈列。模型的尺寸、摆位、纹饰与器物细节为近似或简化，画面尚未完成对照验收。",
    "items": [
      {
        "id": "taihe-throne-screen",
        "title": "宝座与屏风",
        "text": "高台上的雕龙宝座，背后配七扇屏风，前方设独立脚踏。故宫档案记载，这件宝座在库房被重新找到后，经一年多修复，于1964年9月完工。",
        "sourceIds": [
          "taihe-throne-dossier",
          "taihe-throne-photo"
        ]
      },
      {
        "id": "taihe-jianji-suiyou",
        "title": "“建极绥猷”匾",
        "text": "宝座上方的“建极绥猷”原匾为乾隆御笔。故宫2002年记录称原匾下落未明，遂依1900年旧照复制匾联，并于同年9月18日归位。",
        "sourceIds": [
          "taihe-plaque-restoration"
        ]
      },
      {
        "id": "taihe-caisson-pearls",
        "title": "藻井与宝珠",
        "text": "宝座前上方的藻井从方形逐层收为八角和圆形。中央雕龙俯首，官方照片中可见一大六小的球组，周围是带龙纹的格状天花。",
        "sourceIds": [
          "taihe-caisson-study",
          "taihe-caisson-photo"
        ]
      },
      {
        "id": "taihe-six-gold-columns",
        "title": "六根金柱",
        "text": "宝座两侧共有六根金色大柱。柱上的云龙纹以沥粉工艺做出浅浅起伏，再贴深浅两种金箔，让龙纹在金色底面上显得更清楚。",
        "sourceIds": [
          "taihe",
          "taihe-throne-photo"
        ]
      },
      {
        "id": "taihe-four-paired-displays",
        "title": "宝座前的四对陈设",
        "text": "宝座前两侧有宝象、甪端、仙鹤和香亭各一对。象背负瓶，仙鹤颈腿细长；香亭属于亭式香筒类陈设，和鼎式熏炉的造型不同。",
        "sourceIds": [
          "taihe",
          "taihe-throne-photo",
          "taihe-crane-study-p40",
          "taihe-enamel-ensemble",
          "taihe-incense-study"
        ]
      },
      {
        "id": "taihe-ceremony-not-residence",
        "title": "举行大典的正殿",
        "text": "太和殿主要举行登极、册后和节庆朝贺等大典。皇帝日常起居另有寝宫，例如明代皇帝曾住乾清宫；这里的宝座应放在礼仪场景中理解。",
        "sourceIds": [
          "taihe",
          "qianqing"
        ]
      }
    ]
  },
