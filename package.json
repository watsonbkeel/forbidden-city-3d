{
  "name": "forbidden-city-3d",
  "license": "MIT",
  "version": "1.0.0",
  "description": "3D Virtual Tour of the Forbidden City built with Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:perf": "node tests/perf.cjs",
    "test:zones": "node tests/zone-lint.cjs",
    "test:anchors": "node tests/anchor-check.cjs",
    "test:smoke": "node tests/smoke.cjs",
    "test:regression": "node tests/regression.cjs",
    "test:walk": "node tests/stepwalk.cjs 60,10 0,1 all",
    "test:zone-equiv": "node tests/zone-equiv.cjs",
    "test:gate": "node tests/gate.cjs",
    "test:visual": "node tests/visual.cjs",
    "test:current-state": "node --test tests/current-state/*.test.mjs"
  },
  "dependencies": {
    "three": "^0.162.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "playwright": "^1.40.0",
    "vite": "^5.0.0"
  }
